rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regola dedicata per la query collectionGroup('invites') del
    // destinatario (streamMyPendingInvites in family_service.dart): un
    // match annidato (families/{familyId}/invites/{inviteId}, più sotto)
    // governa correttamente get/create/update/delete su un documento
    // preciso, ma Firestore NON lo considera mai per una query
    // collectionGroup — per quello serve un match dichiarato con
    // {path=**} a questo livello. Confermato con un test end-to-end reale
    // (prima con isOwner()+email, poi con l'uid: entrambi restavano
    // "permission-denied" finché la regola non è stata spostata qui) e poi
    // riprodotto/verificato in modo isolato sull'emulatore Firestore.
    match /{path=**}/invites/{inviteId} {
      allow list: if request.auth != null &&
        resource.data.invitedUid == request.auth.uid;
    }

    // Fase G: changelog "Novità e aggiornamenti", collection pubblica in
    // sola lettura per qualunque utente autenticato — il contenuto viene
    // scritto solo manualmente (Firebase Console/Admin SDK), mai dal
    // client, così un utente non può inventarsi voci di changelog false.
    match /changelog/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      function isSelf() {
        return request.auth != null && request.auth.uid == userId;
      }
      // Campi di stato Premium/Trial/billing: scrivibili SOLO dalle Cloud
      // Function (Admin SDK bypassa le regole), mai dal client diretto —
      // altrimenti un utente potrebbe auto-assegnarsi Premium o azzerare i
      // propri contatori di utilizzo AI modificando solo l'app.
      function protectedFields() {
        return [
          'isPremium', 'trialEnd', 'scontriniUsati', 'richiesteAiUsate',
          'analisiAvanzateUsate', 'playProductId', 'playPurchaseToken',
          'playSubscriptionExpiry',
        ];
      }

      allow read: if isSelf();
      allow create: if isSelf() &&
        !request.resource.data.keys().hasAny(protectedFields());
      allow update: if isSelf() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(protectedFields());
      allow delete: if isSelf();

      match /envelopes/{envelopeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /incomes/{incomeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /recurringExpenses/{recurringExpenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notifications/{notificationId} {
        // Scritte solo dalle Cloud Function (Admin SDK, sendPushAndLog in
        // functions/index.js) — il client legge lo storico e può solo
        // segnare una notifica come letta, mai crearne/eliminarne una
        // propria (sarebbe una notifica finta, mai davvero inviata).
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
      }
    }

    match /families/{familyId} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
      }
      function isOwner() {
        return request.auth != null &&
          get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid;
      }

      allow read: if isMember();
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner();

      match /members/{memberId} {
        allow read: if isMember();
        // Solo l'owner aggiunge membri (incluso se stesso, alla creazione
        // della famiglia: a quel punto il documento famiglia esiste già con
        // ownerId == suo uid, quindi isOwner() è già vero). Prima permetteva
        // anche "request.auth.uid == memberId", che lasciava chiunque
        // auto-iscriversi a QUALSIASI famiglia di cui conoscesse l'id,
        // bypassando l'invito.
        allow create: if isOwner();
        allow update, delete: if isOwner();
      }

      match /invites/{inviteId} {
        // list() (query collectionGroup del destinatario) è dichiarata a
        // parte, in un match top-level {path=**} in cima al file — vedi
        // commento lì: Firestore non applica un match annidato come questo
        // a una query collectionGroup, solo a get/create/update/delete su
        // un path preciso, per cui qui restano solo queste ultime quattro.
        allow get: if request.auth != null &&
          (resource.data.invitedUid == request.auth.uid || isOwner());
        allow create: if isOwner();
        // Il destinatario può solo cambiare lo stato dell'invito (es.
        // accettarlo), mai altri campi come l'email/uid a cui è destinato.
        allow update: if request.auth != null &&
          resource.data.invitedUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status']);
        allow delete: if isOwner();
      }

      match /envelopes/{envelopeId} {
        allow read, write: if isMember();
      }
      match /expenses/{expenseId} {
        allow read, write: if isMember();
      }
      match /incomes/{incomeId} {
        allow read, write: if isMember();
      }
    }
  }
}